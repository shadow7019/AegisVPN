# AegisVPN deployment environment — copy to deploy/env (chmod 600) or export.
# deploy-fleet.sh / deploy-node.sh read these as env overrides.

# Coordination API (server/coord) — where nodes register and clients fetch
# the node list. Format host:port.
export AE_COORD_HOST="coord.example.com:8080"

# Bearer token matching COORD_TOKEN in the coord server's .env.
# Generate: head -c 24 /dev/urandom | base64 | tr -d '/+=' | head -c 24
export AE_COORD_TOKEN="replace-me"

# Obfuscation passphrase shared by the engine (AegisObfsKey) and server
# obfsd (AEGIS_OBFS_KEY). Rotate together.
export AE_OBFS_KEY="replace-me"

# SmartPlay egress IPs (streaming-unlock), comma-separated. Optional.
export SMARTPLAY_IPS="146.70.99.101,146.70.99.102"

# SSH defaults used by deploy scripts (also accepted via --host user@ip):
# export AE_SSH_USER="root"
