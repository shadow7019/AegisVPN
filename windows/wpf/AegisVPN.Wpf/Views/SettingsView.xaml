<UserControl x:Class="AegisVPN.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Settings" Style="{StaticResource H1Style}" Margin="0,0,0,12"/>

            <!-- ── protection ─────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="PROTECTION" Style="{StaticResource MutedStyle}" FontSize="10"/>
                    <CheckBox Content="Kill Switch — block all traffic if the tunnel drops"
                              Style="{StaticResource ToggleSwitchStyle}" Margin="0,12,0,0"
                              IsChecked="{Binding KillSwitch, Mode=TwoWay}"/>
                    <CheckBox Content="Threat Protection — DNS-level ads / trackers / malware blocking"
                              Style="{StaticResource ToggleSwitchStyle}" Margin="0,12,0,0"
                              IsChecked="{Binding ThreatProtection, Mode=TwoWay}"/>
                    <CheckBox Content="Auto-connect on launch"
                              Style="{StaticResource ToggleSwitchStyle}" Margin="0,12,0,0"
                              IsChecked="{Binding AutoConnect, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- ── obfuscation ────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="OBFUSCATION" Style="{StaticResource MutedStyle}" FontSize="10"/>
                    <TextBlock Text="Masks WireGuard UDP against DPI (matches server obfsd). Requires the shared passphrase."
                               Style="{StaticResource MutedStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <CheckBox Content="Enable obfuscation" Style="{StaticResource ToggleSwitchStyle}" Margin="0,12,0,0"
                              IsChecked="{Binding Obfuscate, Mode=TwoWay}"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ObfsKeyBox" Margin="0,0,0,0"
                                     Background="{StaticResource InputBgBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource CardBorderBrush}"
                                     CaretBrush="{StaticResource AccentBrush}"
                                     Padding="10,8" FontSize="13"
                                     PasswordChanged="OnObfsKeyChanged"/>
                        <TextBlock Grid.Column="1" Text="AegisObfsKey" Style="{StaticResource MutedStyle}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── dns ────────────────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="DNS" Style="{StaticResource MutedStyle}" FontSize="10"/>
                    <TextBlock Text="Comma-separated resolvers applied on connect (default: node's Threat Protection DNS)."
                               Style="{StaticResource MutedStyle}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBox Style="{StaticResource DarkTextBoxStyle}" Margin="0,12,0,0"
                             Text="{Binding DnsServers, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                </StackPanel>
            </Border>

            <!-- ── split tunneling ────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="SPLIT TUNNELING" Style="{StaticResource MutedStyle}" FontSize="10"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- exclude -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Excluded from tunnel" Style="{StaticResource BodyStyle}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding NewExclude, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="8,0,0,0" Command="{Binding AddExcludeCommand}"/>
                            </Grid>
                            <ListBox Style="{StaticResource FlatListBoxStyle}" MinHeight="44" MaxHeight="150"
                                     ItemsSource="{Binding SplitExclude}" Margin="0,8,0,0" x:Name="ExcludeList">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,2">
                                            <TextBlock Text="{Binding}" Style="{StaticResource BodyStyle}"/>
                                            <Button Content="✕" HorizontalAlignment="Right"
                                                    Style="{StaticResource WindowButtonStyle}" Width="28" Height="22"
                                                    Command="{Binding DataContext.RemoveExcludeCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- include -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Forced through tunnel" Style="{StaticResource BodyStyle}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource DarkTextBoxStyle}"
                                         Text="{Binding NewInclude, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="Add" Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="8,0,0,0" Command="{Binding AddIncludeCommand}"/>
                            </Grid>
                            <ListBox Style="{StaticResource FlatListBoxStyle}" MinHeight="44" MaxHeight="150"
                                     ItemsSource="{Binding SplitInclude}" Margin="0,8,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,2">
                                            <TextBlock Text="{Binding}" Style="{StaticResource BodyStyle}"/>
                                            <Button Content="✕" HorizontalAlignment="Right"
                                                    Style="{StaticResource WindowButtonStyle}" Width="28" Height="22"
                                                    Command="{Binding DataContext.RemoveIncludeCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── profile import ─────────────────────────────────────── -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="WG-QUICK PROFILE" Style="{StaticResource MutedStyle}" FontSize="10"/>
                    <TextBlock Text="Connect from a raw .conf profile (supports AegisObfs extensions)."
                               Style="{StaticResource MutedStyle}" Margin="0,6,0,0"/>
                    <Button Content="Import &amp; connect" Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,12,0,0" HorizontalAlignment="Left"
                            Command="{Binding ImportProfileCommand}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
