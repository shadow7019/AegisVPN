<UserControl x:Class="AegisVPN.Wpf.Views.BreachView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Dark Web Monitor" Style="{StaticResource H1Style}" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource BodyStyle}" Margin="0,0,0,12"/>

        <!-- lookup bar -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource DarkTextBoxStyle}" MinWidth="320" HorizontalAlignment="Left"
                         Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="Check breaches" Margin="12,0,0,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CheckCommand}"/>
            </Grid>
        </Border>

        <!-- results -->
        <ListBox Grid.Row="3" Style="{StaticResource FlatListBoxStyle}"
                 ItemsSource="{Binding Breaches}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="10" Padding="4">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayTitle}"
                                           FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding PwnCount, Converter={StaticResource PwnCount}}"
                                           Style="{StaticResource MutedStyle}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource MutedStyle}" Margin="0,2,0,0">
                                <Run Text="{Binding Domain, Mode=OneWay, TargetNullValue='' }"/>
                                <Run Text="{Binding BreachDate, Mode=OneWay, StringFormat='breached {0}', TargetNullValue=''}"/>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding DataClasses}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ChipBorder}" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}" FontSize="10"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
