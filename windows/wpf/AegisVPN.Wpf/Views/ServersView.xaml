<UserControl x:Class="AegisVPN.Wpf.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Servers" Style="{StaticResource H1Style}"/>
                <Button Content="⟳ Refresh" Margin="16,4,0,0" VerticalAlignment="Center"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>
            <TextBox Width="280" HorizontalAlignment="Right"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="13"/>
        </Grid>

        <!-- double vpn relay picker -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="DOUBLE VPN EXIT" Style="{StaticResource MutedStyle}"
                           FontSize="10" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding RelayChoices}"
                          SelectedItem="{Binding SelectedRelay, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" MinWidth="260"
                          Background="{StaticResource InputBgBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Grid.Column="2" Text="connect via this node first, then exit through the selected relay"
                           Style="{StaticResource MutedStyle}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </Grid>
        </Border>

        <!-- node list -->
        <ListBox Grid.Row="2" Style="{StaticResource FlatListBoxStyle}"
                 ItemsSource="{Binding NodesView}"
                 SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                 MouseDoubleClick="OnNodeDoubleClick"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource CountryHeaderStyle}"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding CountryFlag}" FontSize="18"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Id}" FontFamily="Segoe UI" FontSize="14"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding City}" Style="{StaticResource MutedStyle}"/>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource ChipBorder}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding TypeBadge}" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0" Width="90">
                            <Grid>
                                <ProgressBar Style="{StaticResource LoadBarStyle}" Value="{Binding Load, Mode=OneWay}"/>
                            </Grid>
                            <TextBlock Text="{Binding LoadPercent}" Style="{StaticResource MutedStyle}"
                                       FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Margin="0,0,14,0"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold">
                            <Run Text="{Binding LatencyMs, Mode=OneWay}"/> ms
                        </TextBlock>

                        <Button Grid.Column="5" Content="Connect" VerticalAlignment="Center"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                CommandParameter="{Binding}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
